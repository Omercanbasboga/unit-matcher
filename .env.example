# Copy to .env. Everything here is optional; without a database the matcher
# still runs and writes JSON files.

# PostgreSQL (engine/db_sink.py, scripts/seed_postgres.py)
PGHOST=localhost
PGPORT=5432
PGDATABASE=unit_matcher
PGUSER=postgres
PGPASSWORD=

# MongoDB, analysis only (engine/mongo_sink.py)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=unit_matcher
MONGO_USER=mongo
MONGO_PASSWORD=

# Ollama for the LLM fallback (engine/llm_fallback.py)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3:8b
